---
/**
 * The map view for one city.
 *
 * Server-rendered state, in the same shape as the homepage panel: the numbers
 * and their sources are in the HTML before any script runs. What is *not*
 * server-rendered is the geometry — a static image of the rings would be a
 * picture of the numbers, and the point of this page is that the rings sit on
 * real ground. So with scripting off this page shows the readout list and a
 * line saying the map needs scripting; it never shows an empty frame.
 *
 * The default state is the tabulated 100 kt air burst, which is the only state
 * this markup has to carry: every preset and every scaled yield is a client
 * re-render of the same list from the same JSON.
 */
import type { Burst, YieldKt } from '../lib/effects';
import type { City } from '../lib/cities';
import { coordText } from '../lib/cities';
import { BURST_LABEL, panelRows } from '../lib/panel';
import { buildIsland } from '../lib/island';
import {
  PRESETS,
  YIELD_OPTIONS,
  fmtKt,
  presetOptionText,
  tabulatedLine,
} from '../lib/weapons';
import CitySearch from './CitySearch.astro';

interface Props {
  city: City;
  y: YieldKt;
  burst: Burst;
  cities: City[];
}

const { city, y, burst, cities } = Astro.props;

const rows = panelRows(burst, y);
const island = buildIsland(city, y, burst, cities, true);
const heaviest = rows.reduce((m, r) => (r.r !== null && r.r > m ? r.r : m), 0);
const defaultOption = YIELD_OPTIONS.find((o) => o.kt === y)?.id ?? 'y100';
---

<section class="map-app" id="bomb-map" aria-labelledby="map-title">
  <div class="map-head">
    <h2 id="map-title">
      <span data-bind="place">{city.name}</span>
      <span class="sep">·</span>
      <span data-bind="setting">
        {y.toLocaleString('en-US')} kt · {burst === 'air' ? 'air burst' : 'contact burst'}
      </span>
    </h2>
    <p class="map-sub" id="map-sub">
      Ring centre <span data-bind="coords">{coordText(city)}</span> — a GeoNames gazetteer
      point, not an administrative centroid.
    </p>
    <p class="map-sub map-point" id="map-point" hidden>
      <span data-bind="point-coords"></span>
      <span class="sep">·</span>
      <span data-bind="near" data-placeholder="1">near —</span>
    </p>
  </div>

  <form class="map-controls" id="map-controls" aria-label="Map settings">
    <fieldset>
      <legend>City</legend>
      <select name="city">
        {
          cities.map((c) => (
            <option value={c.slug} selected={c.slug === city.slug}>
              {c.name}
            </option>
          ))
        }
      </select>
    </fieldset>

    <fieldset class="pick">
      <legend>Warhead or yield</legend>
      <select name="preset">
        <optgroup label="Yields printed in the manual">
          {
            YIELD_OPTIONS.map((o) => (
              <option value={o.id} selected={o.id === defaultOption}>
                {fmtKt(o.kt)} kt
              </option>
            ))
          }
        </optgroup>
        <optgroup label="Weapons">
          {
            PRESETS.map((p) => (
              <option value={p.id}>{presetOptionText(p)}</option>
            ))
          }
        </optgroup>
      </select>
    </fieldset>

    <fieldset>
      <legend>Burst</legend>
      <div class="seg">
        {(['air', 'ground'] as Burst[]).map((bb) => (
          <label>
            <input type="radio" name="burst" value={bb} checked={bb === burst} />
            <span>{bb === 'air' ? 'Air' : 'Contact'}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </form>

  <CitySearch label="Search any city" />

  <figure class="map-figure">
    <div class="map-frame" id="map-frame" data-mode="pending">
      <canvas id="map-fallback" aria-hidden="true"></canvas>
      <div id="map" aria-hidden="true"></div>
      <canvas id="map-rings" role="img" aria-label={`Rings at ${rows
        .filter((r) => r.r !== null)
        .map((r) => `${r.name} ${r.km} km`)
        .join(', ')}`}></canvas>
      <p class="map-note" id="map-note" hidden></p>
      <p class="map-hint" id="map-hint">Click the map to move the rings to that point.</p>
    </div>
    <figcaption>
      Rings are true ground distances — drawn from a geodesic circle and projected, not a
      screen-space circle. Basemap © OpenFreeMap, map data © OpenStreetMap contributors;
      the fallback outline is Natural Earth 110m, public domain. Rotation and pitch are
      disabled: a ground circle is only honest on a north-up, flat map.
    </figcaption>
  </figure>

  <p class="map-nojs">
    The map draws with scripting. The distances it would draw for this city are listed
    below, and every combination is in the <a href="/blast-radius/">nuclear bomb blast radius</a>
    table.
  </p>

  <p class="map-popsrc" id="map-popsrc" hidden></p>

  <ul class="map-readout" id="map-readout">
    {
      rows.map((row) => (
        <li class="map-ro" data-absent={row.absent ? '1' : undefined}>
          <span class="dot" style={`background:${row.color}`} />
          <span class="nm">{row.name}</span>
          <span class="v">
            {row.absent ? '—' : row.km}
            {!row.absent && <span class="u">km</span>}
          </span>
          <span class="src">{row.absent ? row.reason : row.src}</span>
        </li>
      ))
    }
  </ul>

  <p class="map-basis" id="map-basis-tab">{tabulatedLine(rows)}</p>
  <p class="map-basis" id="map-basis-scale" hidden></p>

  <p class="small map-scale">
    Outermost ring {heaviest.toFixed(2)} km. Figures from the{" "}
    <a href="/blast-radius/">nuclear bomb blast radius</a> table — same JSON, same printed pages.
  </p>

  <h3 class="presets-h">The twelve presets, and the line that states each yield</h3>
  <p class="small presets-intro">
    Each yield below is the figure the cited page prints, not a round number chosen here.
    Where a page prints a range, the preset uses a value inside it and the note says which.
    The quoted line is what the page actually says.
  </p>
  <div class="presets-wrap">
    <table class="presets">
      <thead>
        <tr>
          <th scope="col">Weapon</th>
          <th scope="col">Country</th>
          <th scope="col">Year</th>
          <th scope="col">Yield</th>
          <th scope="col">What it was</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          PRESETS.map((p) => (
            <tr>
              <th scope="row">{p.name}</th>
              <td>{p.country}</td>
              <td class="num">{p.year}</td>
              <td class="num">
                {p.kt_range
                  ? `${fmtKt(p.kt)} kt (${p.kt_range[0]}–${p.kt_range[1]} kt range)`
                  : `${fmtKt(p.kt)} kt`}
              </td>
              <td>{p.note}</td>
              <td class="src-cell">
                <a href={p.source.url} target="_blank" rel="noopener">
                  {p.source.label}
                </a>
                <q>{p.quote_yield}</q>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="small presets-note">
    Two edges belong to the presets themselves. §3.61 states the cube-root law for yields “up to
    (and including) the megaton range”, and the six presets above 1&nbsp;Mt apply it past that.
    Fig.&nbsp;7.42 stops at 10&nbsp;Mt, so Ivy Mike, Castle Bravo, B41 and Tsar Bomba carry no
    thermal ring at all — a gap in the source, not a zero on this page.
  </p>

  <script type="application/json" id="apoca-map-island" set:html={JSON.stringify(island)} />
</section>

<script>
  import '../scripts/bomb-map';
</script>
