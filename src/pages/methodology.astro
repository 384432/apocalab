---
import Base from '../layouts/Base.astro';
import { crossChecks, entries, fmtFt, fmtKm, get, manual } from '../lib/effects';
import gateCounts from '../data/gate-counts.json';
import { getCity } from '../lib/cities';
import {
  CATCH_RADIUS_KM,
  CITY_RADIUS_KM,
  MAX_RING_KM,
  fmtPeople,
  peopleWithin,
  popSource,
} from '../lib/city-pop';
import popMeta from '../data/pop-meta.json';

const checked = entries.filter((e) => e.checked_by !== null).length;
const total = entries.length;

// The clicked-point grid, read from the same metadata the map island carries:
// a number typed into this sentence would drift away from the tiles.
const clickCellKm = popMeta.grid.cell_km_equator.toFixed(2);
// Two decimals, not one: the bound is 2.968%, and "3.0%" would read as "exactly
// 3%", i.e. as if the site had spent its whole error budget by design.
const clickBinPct = (100 * popMeta.bins.max_relative_error).toFixed(2);
const clickCellDeg = `${(1 / 24).toFixed(4)}°`;
/** 30 arc-seconds is 0.93 km at the equator; the source names itself "1 km". */
const clickSourceRes = `${(popMeta.source.resolution_deg * 111.319).toFixed(0)} km`;

// The dataset name carries a comma from the API ("Global2 R2025A, 100 m"); in
// running text that comma reads as a list separator, so it becomes one name.
const datasetName = popSource.name.replace(/,\s*/, ' ');

// One disc, two surfaces. 780,593 is read from city-pop.json at build time;
// 831,462 is the same disc summed over the downloadable constrained 2020
// GeoTIFF by scripts/check_raster_sum.py. The gap is a release difference and
// it is printed, not smoothed away.
const PARIS_TIF_SUM = 831462;
const parisKm = get('overpressure_5psi', 'air', 100)!.radius_km;
const parisApi = peopleWithin(getCity('paris')!, parisKm);
const versionGapPct = (100 * (PARIS_TIF_SUM - parisApi)) / parisApi;
---

<Base
  title="How Nuclear Blast Radius Is Calculated — Sources and Limits"
  description="How each radius was read off the 1977 manual's charts, which figures are scaled from the 1 kt curves, and where the manual's assumptions run out."
  path="/methodology/"
  current="methodology"
>
  <p class="eyebrow">Audit trail</p>
  <h1>Where each number comes from, and where the manual stops</h1>

  <p class="lede">
    This page is the audit trail for the <a href="/blast-radius/">nuclear bomb blast radius</a>
    table. It gives the source, the exact figure and printed page, the way each value was obtained,
    and the places where the underlying chart runs out of assumptions. If a number here cannot be
    traced to a page of the manual, it does not belong on the site.
  </p>

  <p>
    Two pages consume these values. The <a href="/">nuke simulator</a> shows them around one city
    at a time; the <a href="/nuclear-bomb-map/">nuclear bomb map</a> draws the same rings over real
    ground. Neither page carries a number that is not accounted for below.
  </p>

  <h2 id="source">The source</h2>

  <dl class="spec">
    <div><dt>Title</dt><dd>{manual.title}</dd></div>
    <div><dt>Editors</dt><dd>{manual.editors.join(', ')}</dd></div>
    <div><dt>Edition</dt><dd>{manual.edition} edition, {manual.year}</dd></div>
    <div><dt>Publisher</dt><dd>{manual.publisher.join(' / ')}</dd></div>
    <div><dt>DOI</dt><dd><code>{manual.doi}</code></dd></div>
    <div>
      <dt>Status</dt>
      <dd>
        U.S. government publication, public domain. No permission is required to reproduce it, and
        nothing on this site is a derivative model built on top of it beyond the scaling law the
        manual itself prints.
      </dd>
    </div>
    <div>
      <dt>Page numbers</dt>
      <dd>
        Every citation uses the <strong>printed</strong> page number, not the position inside a PDF.
        The two differ: in the full scan (<code>6852629.pdf</code>) chapter 3 starts at printed page
        + 9; the chapter files extracted from the same scan differ again. A reader holding the book
        needs the printed number, so that is what is cited.
      </dd>
    </div>
  </dl>

  <h2 id="effects">How each figure was obtained</h2>

  <p class="tbl-hint">Scroll the table sideways →</p>
  <div class="tbl-wrap">
    <table class="data">
      <caption>Source of each row in the blast radius table.</caption>
      <thead>
        <tr>
          <th scope="col">Effect</th>
          <th scope="col">Source</th>
          <th scope="col">Printed page</th>
          <th scope="col">Method</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Fireball, air burst</th>
          <td>Eq. (2.127.1)</td>
          <td>70</td>
          <td>Printed equation, R = 110·W<sup>0.4</sup> ft. No chart reading.</td>
        </tr>
        <tr>
          <th scope="row">Fireball, contact burst</th>
          <td>Eq. (2.127.2)</td>
          <td>71</td>
          <td>Printed equation, R = 145·W<sup>0.4</sup> ft. No chart reading.</td>
        </tr>
        <tr>
          <th scope="row">5 psi</th>
          <td>Fig. 3.73c</td>
          <td>115</td>
          <td>
            Read at the peak of each contour, interpolated between 4 and 6 psi, then scaled by
            W<sup>1/3</sup>.
          </td>
        </tr>
        <tr>
          <th scope="row">1 psi</th>
          <td>Fig. 3.73c</td>
          <td>115</td>
          <td>Read at the peak of the outermost contour, then scaled by W<sup>1/3</sup>.</td>
        </tr>
        <tr>
          <th scope="row">20 psi</th>
          <td>Fig. 3.73b</td>
          <td>113</td>
          <td>
            Read at the peak of the 20 psi contour on the intermediate-pressure panel — the panel
            whose printed labels are 10, 15, 20, 30, 50, 100 and 200 psi — then scaled by
            W<sup>1/3</sup>. Not printed on Fig. 3.73c.
          </td>
        </tr>
        <tr>
          <th scope="row">Thermal, 2nd degree</th>
          <td>Fig. 7.42</td>
          <td>291</td>
          <td>Read directly at each yield column, at 4.5 cal/cm². Not scaled.</td>
        </tr>
        <tr>
          <th scope="row">Thermal, 3rd degree</th>
          <td>Fig. 7.42</td>
          <td>291</td>
          <td>Read directly at each yield column, at 10 cal/cm². Not scaled.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="intermediate">The 20 psi contour, and why it comes from another panel</h2>

  <p>
    The low-pressure panel of Fig. 3.73 (printed page 115) prints 1, 2, 4, 6, 8 and 10 psi. There is
    no 20 psi contour on it, and the manual does not print one anywhere else in that family except
    on the intermediate-pressure panel, Fig. 3.73b (p. 113), whose labels run 10, 15, 20, 30, 50,
    100 and 200 psi. The 20 psi row therefore cites Fig. 3.73b, not Fig. 3.73c, and every cell says
    so. Its distance is not derived from the 5 psi or 10 psi values by any formula: it is the same
    cube-root multiplication applied to a separately read 1 kt contour, and that contour is a
    printed line.
  </p>
  <p>
    Fig. 3.73b is drawn at a different scale and over a different range of distances and burst
    heights from the low-pressure panel, so its pixel calibration is its own:
    <code>x = 348.5 + 2.2467·d</code> and <code>y = 2521.5 − 2.2540·h</code>, both in pixels per
    foot, taken from the equally spaced grid lines in each direction. Two independent readings
    check it, and neither is a fit to the curves:
  </p>
  <ul>
    <li>
      The manual's own worked example on p. 112 — 50 psi at a ground distance of 400 ft and a burst
      height of 500 ft — lands at 410 ft on the digitised panel, 2.5% further out. That is the
      calibration, the same way p. 114 is the calibration for the low-pressure panel.
    </li>
    <li>
      The 100 psi contour, which both panels print, reads 363 ft at 210 ft burst height here and
      about 360 ft at 190 ft on Fig. 3.73a (p. 111), the high-pressure panel: under 1% apart where
      the two panels overlap.
    </li>
  </ul>
  <p>
    The 20 psi peak is then read the same way as every other overpressure peak — at the point where
    the contour reaches furthest from ground zero — giving 928 ft at a burst height of 611 ft for
    1 kt, from the apex of a parabola fitted through the traced contour within ±40 ft of its
    maximum. The contact-burst value is read where the same contour meets the bottom edge of the
    panel; it is 725 ft at 30 ft burst height with a local slope of 0.178 ft per foot, extrapolated
    over the last 30 ft to 720 ft at zero.
  </p>

  <h2 id="hob">Height of burst</h2>

  <p>
    Height of burst is read off the chart, not chosen in advance. Each overpressure contour has a
    point where it reaches furthest from ground zero; that point fixes a distance and a burst
    height together, and both are used. The manual works its own example the same way:
  </p>
  <p class="note">
    “From Fig. 3.73c, the maximum ground distance to which 4 psi extends for a 1 KT weapon is 2,600
    feet. This occurs for a burst height of approximately 1,100 feet.” — p. 114
  </p>
  <p>
    Reading that same point off the digitised chart gives 2,618 ft, a difference of 0.7%, and the
    whole family of contours is calibrated from that agreement. Burst heights scale with the same
    cube-root law as distances, because a contour is only "the same contour" if the geometry is
    scaled with it.
  </p>

  <p>
    <strong>Contact bursts</strong> use height of burst = 0 and are read where each contour meets
    the bottom edge of the figure, the convention the manual states on p. 106.
  </p>

  <p class="note note--warn">
    <strong>Where the chart stops: the high burst heights.</strong>
    Peak burst heights scale to 6,110 ft at 20 psi, 10,174 ft at 5 psi and 15,750 ft at 1 psi for
    1 Mt, and to 7,311 ft for 1 psi at 100 kt. Fig. 3.73 is computed for a homogeneous sea-level
    atmosphere at burst heights of 5,000 ft or less (§3.73, p. 110). Those cells therefore extrapolate the
    chart's assumption by up to a factor of three. They are kept because the scaling law is the
    manual's own and the alternative — silently dropping the largest yield — would hide the
    limitation instead of stating it. No altitude
    correction from §3.64–3.66 is applied, and that omission pushes the figures low rather than
    high. Treat them as the edge of what this chart supports, not as precise distances.
  </p>

  <h2 id="overpressure">What “psi” means on this site</h2>

  <p>
    Fig. 3.73 plots <strong>peak overpressure on the ground</strong>. That is not the same quantity
    as the incident (side-on) pressure in free air: the ground reflects the shock front, so the
    peak value is higher, and for the same psi the distance is larger. A tool that quotes incident
    overpressure will report a noticeably smaller radius for the same number, and both can be right
    about different quantities. This site reports the manual's quantity and says so in every cell.
  </p>
  <p>
    Nothing here converts overpressure into a damage or casualty statement. The manual contains
    such tables; this site does not reproduce them yet, and does not improvise its own.
  </p>

  <h2 id="thermal">Thermal assumptions</h2>

  <p>
    Every thermal figure is a <strong>slant range</strong>, read off a chart computed for air bursts
    at burst heights of 200·W<sup>0.4</sup> ft with 12-mile visibility (§7.42, p. 290). §12.66
    (p. 563) notes that at ranges much greater than the burst height the slant range may be taken as
    the distance to ground zero, which is how it is reported.
  </p>
  <p>The two columns are thresholds, not a range of outcomes:</p>
  <ul>
    <li>
      <strong>4.5 cal/cm² — second degree.</strong> The lower edge of the band the manual associates
      with second-degree burns in unshaded light skin. §12.65 (p. 563) states that at 4.5–6 cal/cm²
      about 18% of an exposed population receives second-degree burns and the remainder first-degree.
    </li>
    <li>
      <strong>10 cal/cm² — third degree.</strong> Read from the same chart and reported as the
      third-degree column; the burn-severity chart behind the threshold is Fig. 12.64 (p. 564).
    </li>
  </ul>
  <p>
    Assumptions that move these numbers and are <em>not</em> adjusted for: light skin tone, no
    clothing, no shelter, no haze or cloud, no evasive action, and a person facing the burst. Darker
    skin needs more irradiance for the same burn; clothing and shade can remove the exposure
    entirely. These are the manual's conditions, restated, not this site's preferences.
  </p>
  <p>
    <strong>No thermal rows are given for contact bursts.</strong> Fig. 7.42 is an air-burst chart,
    and the manual handles surface-burst thermal radiation through a different procedure (§7.41,
    p. 290). Rather than splice two procedures into one column, the contact-burst table reports
    blast and fireball only.
  </p>

  <h2 id="calibration">How the thermal contours were identified</h2>

  <p class="note note--warn">
    <strong>Read this before checking the thermal figures.</strong>
    Fig. 7.42 is a scan with no text layer: the numeric labels printed beside its contour lines
    cannot be extracted, and they are not reliably legible at the resolution of the available
    scan. The six thermal values on this site therefore do <em>not</em> come from reading those
    labels. They come from reading the <em>geometry</em> of the curves and then fixing which curve
    is which from two independent statements in the manual.
  </p>

  <p>Those two statements are:</p>
  <ul>
    <li>§12.66 (p. 563): at 1 Mt, 4.5–6 cal/cm² reaches a slant range of 9–10 miles.</li>
    <li>§7.43 (p. 290): at 1 Mt, 8 cal/cm² reaches about 7 miles.</li>
  </ul>
  <p>
    Together they fix the order and the spacing of the contours from the outside in: 4.5, 6, 8, 10,
    15, 25 cal/cm². Applying that ordering to the digitised curves reproduces both statements
    within a few percent, and the third anchor is reproduced as well — the table below shows all
    three. That agreement is the evidence; the labels are not. Anyone re-checking these values
    should expect to re-derive the contour order the same way, and should treat a mismatch between
    our curve order and the printed labels as the first thing to look at.
  </p>

  <h2 id="scaling">Cube-root scaling, and what it is not</h2>

  <p>
    The chart is drawn for 1 kt. Distances for the other yields come from Eq. (3.61.2), p. 101 —
    the manual's statement that, for a given overpressure, distance scales as W<sup>1/3</sup> — which
    is restated in §3.62 (p. 102) and applied to these same figures in §3.73 (p. 110). Height of
    burst scales the same way.
  </p>
  <p>
    This is the one place where a number on the site is not a direct transcription. It is a
    multiplication the manual instructs, not a model this site invented, and it happens once at
    build time: the JSON ships finished values, and no arithmetic runs in the browser. Each scaled
    entry also ships the 1 kt reading and the pixel coordinates it was read at, so the
    multiplication can be re-done by hand. The page label for every such value is
    <code>scaled from the 1 kt curve (§3.61, p.101)</code>.
  </p>

  <h2 id="checks">Cross-checks</h2>
  <p>
    Five statements in the manual's prose, used as independent anchors — three thermal, two blast.
    They are the reason the digitised curves are trusted; they are not a substitute for the
    citations above.
  </p>

  <p class="tbl-hint">Scroll the table sideways →</p>
  <div class="tbl-wrap">
    <table class="data">
      <caption>Digitised reading against the sentence in the manual.</caption>
      <thead>
        <tr>
          <th scope="col">Check</th>
          <th scope="col">Manual</th>
          <th scope="col">Read here</th>
          <th scope="col">Difference</th>
        </tr>
      </thead>
      <tbody>
        {
          crossChecks.map((c) => (
            <tr>
              <th scope="row">
                {c.claim}
                <span class="th-sub">{c.manual}</span>
              </th>
              <td>{c.id}</td>
              <td>
                <span class="v">
                  {c.ours_mi !== undefined ? `${c.ours_mi} mi` : `${fmtFt(c.ours_ft ?? 0)} ft`}
                </span>
              </td>
              <td>
                <span class="v">
                  {c.delta_pct > 0 ? '+' : ''}
                  {c.delta_pct.toFixed(1)}%
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="verification">Verification status</h2>

  <p>
    <strong>{checked} of {total} rows</strong> carry an individual sign-off. {checked === total
      ? <>The last to clear were the 20 psi rows: three yields, air and contact burst, signed
      off on 18 November 2026 after the contour was re-read at 600 dpi against Fig.&nbsp;3.73b
      (p.&nbsp;113). There is no star left in the
      <a href="/blast-radius/">nuclear bomb blast radius</a> table, and nothing in the table is
      waiting on a re-read.</>
      : <>The {total - checked} that do not are all 20 psi rows: three yields, air and contact
      burst. They are marked with a star in the
      <a href="/blast-radius/">nuclear bomb blast radius</a> table, and the star comes off only
      when the contour has been re-read against a fresh render of the printed page, which is what
      a sign-off means here.</>}
  </p>
  <ul>
    <li>
      The fifteen air-burst values carry a sign-off dated 11 November 2026. The twelve headline
      figures — fireball, 5 psi, 1 psi and second-degree thermal, across three yields — were
      independently recomputed by the site owner, and five of them were spot-checked against the
      original figures. The third-degree column was read off the same chart and accepted with them.
    </li>
    <li>
      The nine contact-burst values published before the 20 psi row was added carry a sign-off
      dated 14 November 2026. They read a different edge of the same chart — height of burst zero,
      the bottom edge of Fig.&nbsp;3.73c on p.&nbsp;115 — and that edge was re-read from a 600 dpi
      render of the printed page rather than taken from the earlier digitization: 4 psi at
      1,655 ft, 6 psi at 1,121 ft and 1 psi at 3,830 ft for 1 kt, each within 0.6 percent of where
      the digitized curve meets the edge. The 5 psi row is interpolated between the 4 and 6 psi
      readings, as it is everywhere else on this site, the fireball rows come from
      eq.&nbsp;(2.127.2) rather than from a reading, and the six radii built on those 1 kt bases are
      the cube-root scaling of §3.61. Nothing in the table moved as a result of the re-read; the
      sign-off confirms the numbers that were already published.
    </li>
    <li>
      The six 20 psi rows carry a sign-off dated 18 November 2026. That contour is printed on
      Fig.&nbsp;3.73b (p.&nbsp;113), the intermediate-pressure plate — not on Fig.&nbsp;3.73c,
      which stops at 10 psi. It was re-read from a 600 dpi render at two points on the rising
      branch, three independent probes per row: left edge, ink-weighted centre and right edge.
      The HOB 500 ft row gave 867.7 / 871.5 / 875.3 ft, a spread of 17 px, and the HOB 300 ft row
      778.7 / 781.6 / 784.5 ft, a spread of 13 px. Both sit inside the 20 px stroke width, so the
      reading reproduces. The air peak of 928.0 ft at HOB 612 ft clears the contact value of
      720.2 ft, and the height the peak sits at falls between the two rows it was tested against.
      The same procedure applied to the 10 psi contour, which both plates print, gives 1,464 ft
      from Fig.&nbsp;3.73b and 1,493 ft from Fig.&nbsp;3.73c: 2.0 percent apart against a
      3 percent limit, so the method carries no systematic bias. The 720.2 ft contact value is
      0.2195 km/kt<sup>1/3</sup>, at the low edge of the 0.22–0.24 range published tables quote
      for 20 psi.
    </li>
    <li>
      One earlier attempt at these six rows compared readings taken at different heights of burst
      by folding them back to a contact burst first. That test was wrong and has been withdrawn:
      §3.61 and §3.62 scale a distance by the cube root of the yield at the <em>same</em> scaled
      height, and the manual gives no rule for projecting a reading from one burst height to
      another. The numbers in this table never depended on that projection.
    </li>
  </ul>
  <p>
    The automated check (<code>scripts/verify_data.py</code>) enforces structure, provenance,
    monotonicity, the scaling arithmetic, unit conversions, the interpolation label on every 5 psi
    row, and agreement between the JSON and the CSV ledger. It currently runs
    {gateCounts.verify_data.pass} assertions, and a single failure exits non-zero, which fails
    the build.
  </p>

  <h2 id="population">Population figures</h2>

  <p>
    Five city pages print population, and all five are built the same way: people counted
    <strong>inside a {CITY_RADIUS_KM} km disc around the GeoNames point</strong> of the city, on the
    {datasetName} surface, {popSource.year} estimates. Radius, year, dataset and release are printed
    beside the number rather than filed here, because a head count without a radius and a version
    is not a fact.
  </p>
  <p>
    Administrative city boundaries are deliberately not used: every country defines a city
    differently, so a boundary figure from one country cannot be set beside one from another, and
    comparability is the only thing these numbers are for. Population inside an effect ring is a
    separate figure taken from the same surface and is never merged into the city figure; no ring
    count is ever subtracted from the city count to imply a number of survivors, because the manual
    gives no basis for treating people as an arithmetic remainder. These are resident-population
    counts — not footfall, not daytime population, not casualties.
  </p>
  <p>
    One query per city, run at {CATCH_RADIUS_KM} km rather than {CITY_RADIUS_KM} km. The widest ring
    any city page draws is the 1 Mt 1 psi contour at {fmtKm(MAX_RING_KM)} km, so a
    {CITY_RADIUS_KM} km query would hand back the edge of the catchment and the page would label
    that as the ring — the one error such a page could not survive. {CATCH_RADIUS_KM} km clears the
    widest contour by {fmtKm(CATCH_RADIUS_KM - MAX_RING_KM)} km and returns every other radius in
    the same response. Each ring is its own cumulative count inside that single catchment: fireball,
    20 psi, 5 psi, 1 psi and both thermal contours are read at their own radius, never obtained by
    subtracting a smaller ring from a larger one. The {CITY_RADIUS_KM} km city figure is the
    cumulative at {CITY_RADIUS_KM} km from the same request.
  </p>
  <p>
    The request is <code>POST {popSource.api}</code>, release <strong>{popSource.name}</strong>,
    retrieved {popSource.retrieved}, licence {popSource.license}. It is not the same surface as the
    GeoTIFF files WorldPop publishes for download, and the difference is measurable: inside a
    {fmtKm(parisKm)} km disc over Paris — the 100 kt 5 psi ring — the API returns
    {fmtPeople(parisApi)} people, while the downloadable constrained 2020 GeoTIFF returns
    {fmtPeople(PARIS_TIF_SUM)}, {versionGapPct.toFixed(1)}% more. The gap is a release difference,
    not an integration difference: the two downloadable 2020 files agree with each other to 0.3%,
    and the API's two endpoints agree to 0.6% while taking a 96-sided polygon and a disc. The site
    uses the API surface throughout, so every city page is consistent with every other and
    reproducible against one named release; the gap is recorded here rather than hidden, and anyone
    re-running the query against the older GeoTIFF should expect to land about
    {versionGapPct.toFixed(1)}% away.
  </p>

  <h2 id="clicked">Ring populations at a clicked point</h2>

  <p>
    A clicked point on the <a href="/nuclear-bomb-map/">nuclear bomb map</a> is a different question
    from a city page, so it is answered from a different surface and labelled as one. The map sums
    <strong>{clickCellKm} km cells</strong> — {clickCellDeg} of latitude and longitude, five source pixels of
    the downloadable WorldPop 2020 {clickSourceRes} release (<a
      href="https://www.worldpop.org/" rel="nofollow noopener">CC BY 4.0</a
    >) per side — kept as one byte per cell in 10° × 10° tiles. Each byte is a log bin between 1 and
    3,000,000 people per cell, rebuilt at the geometric midpoint of its bin, so the worst case a
    single cell can be out is {clickBinPct}%; a cell on the rim of a ring counts for the fraction of
    it the circle covers, which is what keeps a 0.21 km ring from being answered with a whole 4.6 km
    cell. A click within 5 km of one of the 20 tabulated cities returns that city's figures from the
    API surface above instead and says <em>snapped to … — tabulated city</em>: two different numbers
    for one place would be worse than one. The tile count is the coarser of the two, so a ring drawn
    a few kilometres outside a city will not reproduce that city's figure, and a ring narrower than
    one cell is a share of that cell — its density, not a measurement of the ground inside it. The
    map names the source of each column rather than leaving the reader to guess which one they are
    looking at.
  </p>

  <h2 id="not">What this site does not compute</h2>
  <ol>
    <li>Casualty or fatality estimates.</li>
    <li>Damage to specific buildings or structures.</li>
    <li>Fallout footprints or dose rates.</li>
    <li>
      Climate consequences of a large exchange. Chapter 9 covers the debris from a single
      explosion; what smoke from many of them does to sunlight, temperature and growing seasons is
      a separate published literature, kept under
      <a href="/nuclear-winter/">nuclear winter</a> with one citation per figure.
    </li>
    <li>Real-time or daytime population.</li>
    <li>Underwater, underground or high-altitude bursts.</li>
    <li>Multiple warheads or salvo effects.</li>
    <li>Terrain shielding, urban canyon effects, or blast propagation through buildings.</li>
    <li>Thermal effects on materials, or ignition and fire spread.</li>
    <li>Electromagnetic pulse.</li>
    <li>Any prediction for a specific event, place or date.</li>
  </ol>

  <h2 id="files">Files and reproduction</h2>

  <dl class="spec">
    <div>
      <dt><code>src/data/effects.json</code></dt>
      <dd>
        Every published value, with citation, burst height, conversion arithmetic, the Chinese
        reading note taken at the chart, and — for scaled entries — the 1 kt base reading and pixel
        coordinates.
      </dd>
    </div>
    <div>
      <dt><code>data-ledger.csv</code></dt>
      <dd>
        One row per value: effect, yield, value in km, unit conversion, chapter, figure, printed
        page, reading method, raw reading. This is the file to check line by line against the book.
      </dd>
    </div>
    <div>
      <dt><code>scripts/build_effects.py</code></dt>
      <dd>Regenerates the JSON and the ledger from the recorded readings. No network access.</dd>
    </div>
    <div>
      <dt><code>scripts/verify_data.py</code></dt>
      <dd>Runs the {gateCounts.verify_data.pass} assertions. Exits non-zero on any failure.</dd>
    </div>
  </dl>

  <p>
    Reproduction recipe for any single value: open the cited figure at the cited printed page, read
    the distance at the stated burst height, multiply by W<sup>1/3</sup> if the cell says
    <code>scaled</code>, and convert feet to metres with 0.3048. If the result differs from the
    table, the reading note in the JSON records the pixel coordinates used, so the disagreement can
    be located rather than argued about.
  </p>
</Base>
